            "DemographicId": "Finance",
            "DemographicValue": "Finance",
            "DemographicTypeId": "AreaofPractice",
            "DemographicTypeValue": "Area of Practice",
            "DataType": "pick"
        }
   ]
})]]></ee:set-payload>
